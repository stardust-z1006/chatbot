# deepChat v1 · 密钥与服务地址（模板）
#
# 用法：复制成 .env 再填值。.env 已被 .gitignore 排除，不要提交。
# 只有 DEEPSEEK_API_KEY 是必需的；DEEPSEEK_BASE_URL 留空即用默认地址。
#
# 优先级：环境变量 > 本文件 > config.yaml > 代码默认。
# 面板上改不了这里的任何一项（面板的 60 项参数里不含密钥）。
#
# 向量服务没有开关：固定走本地 fastembed（bge-small-zh，512 维），
# 记忆原文不出本机。

# 必需：DeepSeek API Key
DEEPSEEK_API_KEY=

# 可选：接口地址（默认 https://api.deepseek.com）
DEEPSEEK_BASE_URL=

# 可选：后台面板凭据。留空 = 本机免鉴权（默认）；填了就整站要 token。
# 和 config.yaml 的 monitor.token 等效，这里写更适合「不想把令牌放进配置文件」。
# 填了之后第一次打开：http://127.0.0.1:8787/?token=你填的值
PANEL_TOKEN=
