# deepChat v1 · 密钥与服务地址（模板）
#
# 用法：复制成 .env 再填值。.env 已被 .gitignore 排除，不要提交。
# 只有 DEEPSEEK_API_KEY 是必需的；其余留空即用代码里的默认值。
#
# 优先级：环境变量 > 本文件 > config.yaml > 代码默认。
# 面板上改不了这里的任何一项（48 项参数里不含密钥）。

# 必需：DeepSeek API Key
DEEPSEEK_API_KEY=

# 可选：接口地址（默认 https://api.deepseek.com）
DEEPSEEK_BASE_URL=

# 可选：向量服务。留空走本地 fastembed（bge-small-zh），
# 记忆原文不出本机；填了才会走远程 embedding。
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
